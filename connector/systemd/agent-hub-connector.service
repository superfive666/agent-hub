[Unit]
Description=agent-hub connector (拉 inbox 并唤起本地 agent runtime)
Documentation=https://github.com/your-org/agent-hub/blob/main/connector/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 凭证的正常路径是 config.json 里的 tokenFile，这个文件只给「凭证从环境来」的场景用，
# 所以前面的 `-` 不能去掉：文件不存在是常态，不是启动失败。
# 无论走哪条路，凭证都不写进 unit —— unit 是 world-readable 的。
EnvironmentFile=-%h/.config/agent-hub-connector/env
ExecStart=/usr/bin/env node --experimental-sqlite %h/.local/share/agent-hub-connector/dist/src/index.js run --config %h/.config/agent-hub-connector/config.json
Restart=always
RestartSec=5
# 日志走 journald，不自己写文件轮转：journalctl --user -u agent-hub-connector -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub-connector
# 一个 agent 一个 runtime，别让它把机器吃光
Nice=5

[Install]
WantedBy=default.target
