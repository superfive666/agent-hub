# ─── 管理员凭证（部署期预置，二选一）────────────────────
# 没有配置管理员时服务必须启动失败，不能悄悄跑起一个谁都能进的实例
ADMIN_AUTH_MODE=password        # password | oidc

# 方式 A：用户名 + 密码
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# 方式 B：Google OIDC —— 只有这一个邮箱能登录
# 四项要么都填，要么都不填：只填邮箱会让服务起得来但没人进得去，启动时会被拒。
# 回调地址要和 Google Cloud Console 里登记的完全一致，形如
#   https://hub.example.com/api/admin/auth/google/callback
ADMIN_GOOGLE_EMAIL=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=

# ─── 密钥 ──────────────────────────────────────────────
# 至少 16 个字符，太短等于没有（签出来的 cookie 能被暴力伪造），启动时会校验。
SESSION_SECRET=

# ─── 存储 ──────────────────────────────────────────────
# 两种写法都认（驱动是 pgx）：
#   postgres://user:pass@host:5432/agenthub?sslmode=disable
#   host=127.0.0.1 port=5432 user=u password=p dbname=agenthub sslmode=disable
# ⚠️ URL 形式里密码含 + / = @ : ? # 必须百分号编码，否则连接串直接解析失败，
#    报的错还跟密码无关（形如 invalid port）。密码里有特殊字符就用键值形式。
# 用 compose 自带的 postgres 时留空即可，compose 会按 POSTGRES_* 拼出来。
DATABASE_URL=

# ─── 服务 ──────────────────────────────────────────────
APP_ENV=development
# 容器内监听端口。compose 会把它合成 APP_ADDR=":$APP_PORT" 传给应用。
APP_PORT=8080
# agent 长轮询最长等多久。调大要连带看 api 的 WriteTimeout。
LONGPOLL_MAX_WAIT=30s
# 看板按天切分所用的平台时区，全局统一
PLATFORM_TIMEZONE=Asia/Singapore

# ─── Android 客户端 ────────────────────────────────────
# GET /download 交出去的那份安装包。**留空是正常的** —— 大多数部署不发 app，
# 留空时 /download 返回一个说得清楚的 503，而不是假装这个端点不存在。
# 产物由 CI 构建后放到这个路径，不进 git。启动时**不校验文件是否存在**：
# 校验会让「先起服务、再发第一个版本」这个正常顺序变成启动失败。
# ⚠️ 这条路径不在 /api/ 下，反向代理必须显式转发（docs/08-deployment.md §5）。
ANDROID_APK_PATH=
# 只用来拼下载的文件名（agent-hub-<version>.apk），不参与任何判断。
# 留空则文件名是 agent-hub.apk —— 用户下载目录里几个版本会分不清哪个新。
ANDROID_APK_VERSION=

# ─── 聊天窗口里的附件（ADR-0011）─────────────────────
# agent 交产物、人递规格书，都靠它。**留空是正常的** —— 留空时上传返回一个
# 说得清楚的 503（不是 404），控制台上那枚回形针自己收起来。
#
# 填的是**容器内**路径，compose 里已经把宿主机的 ./var/attachments 挂到这儿，
# api 与 worker 挂的是同一个（api 写和读，worker 删）。所以正常填法就是：
#   ATTACHMENT_DIR=/srv/attachments
#
# ⚠️ 和 APK 那个只读目录不同，这个**必须可写**，而运行镜像跑的是 nonroot
# （uid 65532）。宿主机上那个目录默认是 root 属主 —— 存在、能读、一写就 EACCES，
# 而只查存在性的自检会报告「一切正常」。建目录的命令见 docs/08-deployment.md §9。
# api 启动时会真写一个文件试一下，不通过就在日志里点名，并且控制台上不画回形针。
ATTACHMENT_DIR=
# 单个附件上限，字节。默认 25 MiB。超了返回 413，消息里带着这个值。
ATTACHMENT_MAX_BYTES=26214400
# 一条帖子最多挂几个附件。默认 8。
ATTACHMENT_MAX_PER_POST=8
# 「传上来了但一直没发帖」的宽限期，也是扫盘 GC 的时间下界。默认 24h。
# 别调得太短：两步上传中间隔着一段时间，agent 先传三个文件再发帖是正常节奏。
ATTACHMENT_ORPHAN_TTL=24h
