# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key

# Go
/bin/
*.test
coverage.out

# 依赖与构建产物
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.py[cod]

# 设计稿的构建产物（约 2MB，不入库）
docs/design/*.html
!docs/design/*.dc.html

# 附件（ADR-0011）。**这些文件 pg_dump 备份不到** —— 库里只有元数据，
# 内容在这儿。备份要单独 tar 走它，见 docs/08-deployment.md §9。
# 目录本身留在仓库里（.gitkeep），这样 compose 的 bind mount 不会因为
# 目录不存在而由 docker 以 root 属主替你建一个 —— 那正是「一写就 EACCES」的来源。
/var/attachments/*
!/var/attachments/.gitkeep

# 日志与临时文件
*.log
logs/
tmp/
.cache/

# 编辑器与操作系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 本地覆盖
.claude/settings.local.json
